---
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
  active?: 'home' | 'projects' | 'contact';
  theme?: 'redfance';
}
const { title, active, theme } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins&family=Rubik&display=swap" />
    <link rel="stylesheet" href="/res/style.css" />
    <script is:inline src="/res/script.js"></script>
  </head>
  <body class:list={[theme && `theme-${theme}`]}>
    <Navbar active={active} />
    <main class="page"><slot /></main>
  </body>
</html>
